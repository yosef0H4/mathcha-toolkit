{
  "name": "mathcha-toolkit",
  "version": "3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:userscript": "node build.mjs",
    "build:extension": "node build.mjs",
    "build:console": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "loop:extension": "node scripts/extension-loop.mjs",
    "pw:install": "playwright install chromium",
    "pw:extension": "playwright test playwright/extension-smoke.spec.js --config=playwright.config.mjs",
    "dev:extension:firefox": "npx web-ext run --source-dir dist/extension/firefox --start-url https://www.mathcha.io/editor",
    "pw:auth": "node scripts/capture-auth.mjs",
    "pw:analyze": "playwright test --config=playwright.config.mjs",
    "pw:analyze:headed": "playwright test --config=playwright.config.mjs --headed",
    "pw:api": "playwright test playwright/api-model.spec.js --config=playwright.config.mjs",
    "pw:runtime": "playwright test playwright/runtime-command.spec.js --config=playwright.config.mjs",
    "pw:runtime:direct": "playwright test playwright/runtime-direct.spec.js --config=playwright.config.mjs",
    "pw:runtime:import": "playwright test playwright/import-direct.spec.js --config=playwright.config.mjs",
    "pw:runtime:answer": "playwright test playwright/answer-insert.spec.js --config=playwright.config.mjs",
    "pw:baseline": "playwright test playwright/dom-baseline.spec.js --config=playwright.config.mjs",
    "pw:runtime:headed": "playwright test playwright/runtime-command.spec.js --config=playwright.config.mjs --headed",
    "py:hello": "node pyodide-cli.mjs hello",
    "py:install": "node pyodide-cli.mjs install",
    "py:solve": "node pyodide-cli.mjs solve"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/tampermonkey": "^5.0.4",
    "esbuild": "^0.25.3",
    "pyodide": "^0.29.3",
    "typescript": "^5.8.3"
  }
}
